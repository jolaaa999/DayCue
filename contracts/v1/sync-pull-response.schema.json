{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daycue.local/contracts/v1/sync-pull-response.schema.json",
  "title": "SyncPullResponse",
  "description": "GET /v1/sync/pull 响应。查询参数 cursor 与 limit 均为可选；cursor 必须是整数版本号，否则返回 400。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changes",
    "cursor",
    "has_more"
  ],
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "version",
          "updated_at",
          "deleted",
          "tombstone",
          "payload"
        ],
        "properties": {
          "type": {
            "enum": [
              "task",
              "note",
              "capture",
              "course",
              "course_instance",
              "follow_up",
              "memory",
              "place",
              "geo_rule",
              "proactive_message"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "description": "该记录当前是否为墓碑。"
          },
          "tombstone": {
            "type": "boolean",
            "description": "与 deleted 同义，为兼容旧客户端而保留。"
          },
          "payload": {
            "description": "实体内容；墓碑或坏数据时服务端下发 null，不会让整个响应失败。"
          }
        }
      }
    },
    "cursor": {
      "type": "string",
      "description": "下一轮拉取的游标，客户端必须原样保存并回传；没有新变更时等于请求里的游标，空串表示从头拉取。"
    },
    "has_more": {
      "type": "boolean",
      "description": "true 表示服务端还有更多变更，客户端应继续拉取。"
    }
  }
}
