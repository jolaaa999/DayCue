{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daycue.local/contracts/v1/extraction-response.schema.json",
  "title": "ExtractionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "mode",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "mode": {
      "enum": [
        "live",
        "fixture"
      ],
      "description": "fixture 必须显式启用，UI 必须标注“模拟结果”"
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "$ref": "#/$defs/usage"
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "localTime": {
      "type": "string",
      "description": "用户时区下的墙上时间，YYYY-MM-DDTHH:MM:SS 或 YYYY-MM-DD"
    },
    "due": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "date",
            "datetime"
          ]
        },
        "local": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "仅 kind=datetime 时有值"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "remind": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "local",
            "utc",
            "timezone"
          ],
          "properties": {
            "kind": {
              "const": "absolute"
            },
            "local": {
              "type": "string"
            },
            "utc": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            }
          }
        }
      ],
      "description": "null 表示没有设置提醒时刻，不等于没有截止时间"
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "已知 code: deadline_only, missing_year, weekday_date_conflict, ambiguous_ampm, ambiguous_place, unresolved_date, past_time, dst_nonexistent, dst_ambiguous, assumed_next_day, model_uncertain"
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "kind",
        "title",
        "source_evidence",
        "date_expression",
        "due",
        "remind",
        "ambiguities"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "在本次响应内唯一，客户端据此去重"
        },
        "kind": {
          "enum": [
            "task",
            "note"
          ],
          "description": "只有行动意图才是 task"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        },
        "source_evidence": {
          "type": "string",
          "maxLength": 2000,
          "description": "原文中支撑该候选的片段"
        },
        "date_expression": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "due": {
          "$ref": "#/$defs/due"
        },
        "remind": {
          "$ref": "#/$defs/remind"
        },
        "course_hint": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "place_hint": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "仅供参考，不得作为自动执行唯一依据"
        }
      }
    }
  }
}
