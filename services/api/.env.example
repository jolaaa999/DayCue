# DayCue 后端最小服务配置样例。
# 复制为 .env 或直接设置为环境变量；.env 不会被提交（见根目录 .gitignore）。
# 真实凭据只放本地环境变量，绝不写进仓库。

# 监听地址。默认只监听本机环回地址。
# 若改成 0.0.0.0 等非环回地址，必须同时设置 DAYCUE_AUTH_TOKEN，否则服务拒绝启动。
DAYCUE_ADDR=127.0.0.1:8787

# development / test / production
DAYCUE_ENV=development

# 访问令牌。设置后所有 /v1 接口都要求 Authorization: Bearer <token>。
# DAYCUE_AUTH_TOKEN=

# 模拟模式：仅用于离线开发与自动化测试。
# 开启后整理结果全部是预设样例，响应 mode=fixture，界面必须显示「模拟结果」。
# 生产环境（DAYCUE_ENV=production）下禁止开启，服务会拒绝启动。
DAYCUE_FIXTURE_MODE=0

# ---- 文本整理（OpenAI-compatible /chat/completions）----
# 不填则 /v1/extractions 返回 503，客户端应显示「AI 未配置」而不是编造结果。
DAYCUE_LLM_BASE_URL=
DAYCUE_LLM_API_KEY=
DAYCUE_LLM_MODEL=gpt-4o-mini
DAYCUE_LLM_TIMEOUT=20s

# ---- 语音转写（OpenAI-compatible /audio/transcriptions）----
DAYCUE_ASR_BASE_URL=
DAYCUE_ASR_API_KEY=
DAYCUE_ASR_MODEL=whisper-1
DAYCUE_ASR_TIMEOUT=60s

# ---- 限额与超时 ----
DAYCUE_MAX_JSON_BYTES=262144
DAYCUE_MAX_AUDIO_BYTES=12582912
DAYCUE_REQUEST_TIMEOUT=30s
DAYCUE_SHUTDOWN_GRACE=5s
